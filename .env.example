# Nothing here is required for the offline demo.
BOSON_API_KEY=
HIGGS_MODEL=higgs-realtime-1.5-preview

OLLAMA_URL=http://localhost:11434
#OLLAMA_MODEL=llama3.2:3b
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=360

HANGON_PROTECTED_PHONE=
HANGON_GUARDIAN_PHONE=
HANGON_MAX_TURNS=10
HANGON_MAX_SECONDS=1200

HANGON_VAD_THRESHOLD=0.92
HANGON_MIN_TURN_WORDS=2
HANGON_MIN_INTERRUPT_WORDS=2
HANGON_CLASSIFIER_GRACE=0.8

GEMINI_API_KEY=-U
GEMINI_MODEL=gemini-3.5-flash-lite

HIGGS_VOICE=
# GEMINI_CALLER_MODEL=   (optional: a different model for the simulated caller, to split rate limits)