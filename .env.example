# Copy only the settings you need into a local, ignored .env file.
BOSON_API_KEY=
HIGGS_VOICE=default
BOSON_REALTIME_URL=wss://api.boson.ai/v1/realtime?model=higgs-realtime
# Browser screening classifier: heuristic, ollama, or gemini.
HANGON_CLASSIFIER=gemini
GEMINI_API_KEY=
GEMINI_TIMEOUT=30
HANGON_STUN_URL=
HANGON_TURN_URL=
HANGON_TURN_SECRET=
HANGON_RELAY_ONLY=0
HANGON_PUBLIC_ORIGIN=
